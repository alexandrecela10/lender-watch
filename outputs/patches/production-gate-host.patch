@@ -0,0 +1,58 @@
+"""The production gate also covers the hosted Lender Watch service on Fly.io (spec check 16)."""
+
+import pytest
+
+from tests.test_production_gate import ROOT, approve, bash, deploy, gate  # noqa: F401 (deploy is a fixture)
+
+NEEDS_APPROVAL = [
+    "make host-deploy",
+    "./scripts/host-deploy.sh",
+    "fly deploy --config deploy/fly.toml",
+    "flyctl deploy",
+    "fly secrets set LW_INVITED=user_1",
+    "fly scale memory 2048",
+    "fly machine stop 123",
+    "fly volumes destroy vol_1",
+    "fly apps destroy lender-watch",
+    "cd /tmp && fly deploy",
+    "bash -c 'fly deploy'",
+]
+
+ALLOWED = [
+    "fly logs",
+    "fly status",
+    "fly releases",
+    "fly version",
+    'git commit -m "document fly deploy and make host-deploy"',
+    "grep -n host-deploy Makefile",
+]
+
+
+@pytest.mark.parametrize("command", NEEDS_APPROVAL)
+def test_hosted_changes_need_approval(deploy, command):
+    result = bash(deploy, command)
+    assert result.returncode == 2, command
+    assert "make approve-prod" in result.stderr
+    approve(deploy)
+    assert bash(deploy, command).returncode == 0, command
+
+
+@pytest.mark.parametrize("command", ALLOWED)
+def test_reading_the_hosted_service_is_allowed(deploy, command):
+    assert bash(deploy, command).returncode == 0, command
+
+
+@pytest.mark.parametrize(
+    "file", ["deploy/fly.toml", "deploy/service.Dockerfile", "scripts/host-deploy.sh"]
+)
+def test_edits_to_the_hosted_definition_need_approval(deploy, file):
+    path = str(ROOT / file)
+    assert gate(deploy, "Write", {"file_path": path}).returncode == 2
+    approve(deploy)
+    assert gate(deploy, "Write", {"file_path": path}).returncode == 0
+
+
+def test_the_deploy_script_keeps_the_approval_for_its_own_check(deploy):
+    approve(deploy)
+    assert bash(deploy, "make host-deploy").returncode == 0
+    assert (deploy / "prod-approval").exists()
