{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.84",
        "--headless",
        "--isolated",
        "--allowed-origins",
        "http://localhost:8501",
        "--output-dir",
        "/tmp/erm-verify"
      ],
      "env": {}
    },
    "entity-reconciliation": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "python",
        "-m",
        "erm.mcp_server"
      ],
      "env": {}
    }
  }
}
