#!/usr/bin/env bash
# Git pre-commit hook: refuses any commit, from any tool or person, that adds a key.
# Install with `make hooks`. Needs no jq.

root=$(git rev-parse --show-toplevel)
hits=$(git diff --cached -U0 --no-color | "$root/scripts/scan-secrets.sh")
if [ "${hits:-0}" -gt 0 ]; then
  echo "Commit refused: $hits added line(s) look like a key or a filled-in .env value." >&2
  echo "Staged files: $(git diff --cached --name-only | tr '\n' ' ')" >&2
  echo "Keys live only in .env, which is git-ignored. Unstage the file, remove the value, and commit again." >&2
  exit 1
fi
exit 0
